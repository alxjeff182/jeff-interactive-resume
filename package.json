{
  "name": "jeff-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,css}\"",
    "check:assets": "node scripts/check-assets.js",
    "perf:budget": "node scripts/check-performance-budget.js",
    "compress:models": "node scripts/compress-models.js",
    "optimize:textures": "node scripts/optimize-textures.js",
    "prepare:decoders": "node scripts/prepare-decoders.js",
    "og:social": "node scripts/optimize-og-social.js",
    "test": "vitest run",
    "release:check": "npm run lint && npm run test && npm run build && npm run perf:budget"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/three": "^0.183.1",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.39.2",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.1.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "three": "^0.183.2"
  }
}
